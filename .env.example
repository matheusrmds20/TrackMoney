ENV=development
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/financeiro

# Aplica `alembic upgrade head` no boot. Ligue em PaaS sem shell/pre-deploy
# (ex.: Render free). Deixe false em dev para rodar migrations manualmente.
RUN_MIGRATIONS=false

FRONTEND_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://
ENABLE_DOCS=true
LOG_LEVEL=INFO
